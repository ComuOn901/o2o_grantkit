  <div class="row">
    <h2>{esc(item["classification"])}</h2>
    <span class="badge">OBSERVATION RECORD</span>
  </div>

  <dl>
    <dt>Title</dt>
    <dd>{esc(p.get("title") or "Untitled")}</dd>

    <dt>Funder</dt>
    <dd>{esc(p.get("funder") or "Unspecified")}</dd>

    <dt>Program</dt>
    <dd>{esc(p.get("program") or "Unspecified")}</dd>

    <dt>Deadline</dt>
    <dd>{esc(p.get("deadline") or "Unspecified")}</dd>

    <dt>Deadline state</dt>
    <dd>{esc(p.get("deadline_state"))}</dd>

    <dt>Completion</dt>
    <dd>{esc(p.get("completion_percent"))}%</dd>

    <dt>Errors</dt>
    <dd>{esc(v.get("errors"))}</dd>

    <dt>Warnings</dt>
    <dd>{esc(v.get("warnings"))}</dd>

    <dt>Bundle</dt>
    <dd>{esc(item.get("bundle_id"))}</dd>
  </dl>

  <h3>MENDER coordination queue</h3>
  {queue_html}

  <div class="truth">
    RECORD_IS_UNIQUE_GRANT=FALSE<br>
    PORTFOLIO_PRIORITY_IS_AUTHORIZATION=FALSE<br>
    AUTHORIZATION_OCCURRED=FALSE<br>
    EXECUTION_OCCURRED=FALSE<br>
    AUTHORITY_CHANGED=FALSE
  </div>
</article>
"""
        )

    classifications = "".join(
        f"<li>{esc(k)}: {esc(v)}</li>"
        for k, v in sorted(
            summary["classifications"].items()
        )
    )

    deadline_states = "".join(
        f"<li>{esc(k)}: {esc(v)}</li>"
        for k, v in sorted(
            summary["deadline_states"].items()
        )
    )

    return f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta
  name="viewport"
  content="width=device-width,initial-scale=1"
>
<title>Commons Funding Portfolio</title>

<style>
body {{
  margin: 0;
  background: #101214;
  color: #eef2f3;
  font-family:
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    sans-serif;
}}

main {{
  max-width: 1150px;
  margin: auto;
  padding: 32px 20px 80px;
}}

.notice,
.summary,
.card {{
  border: 1px solid #343a40;
  border-radius: 14px;
  background: #181c20;
}}

.notice {{
  padding: 16px;
  margin: 20px 0;
}}

.summary {{
  padding: 20px;
  margin-bottom: 22px;
}}

.metrics {{
  display: grid;
  grid-template-columns:
    repeat(auto-fit, minmax(150px, 1fr));
