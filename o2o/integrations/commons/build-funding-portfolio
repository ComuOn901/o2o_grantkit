def main() -> int:
    parser = argparse.ArgumentParser(
        description=(
            "Build a read-only Commons funding "
            "portfolio from PNEUMA evidence."
        )
    )

    parser.add_argument(
        "--evidence-root",
        required=True,
    )

    parser.add_argument(
        "--output",
        required=True,
    )

    args = parser.parse_args()

    evidence_root = (
        Path(args.evidence_root)
        .expanduser()
        .resolve()
    )

    output = (
        Path(args.output)
        .expanduser()
        .resolve()
    )

    ledger = load_ledger(
        evidence_root / "ledger.jsonl"
    )

    observations = [
        load_observation(record)
        for record in ledger
    ]

    summary = build_summary(
        observations
    )

    output.mkdir(
        parents=True,
        exist_ok=True,
    )

    portfolio = {
        "schema":
            "o2o.commons-funding-portfolio.v1",

        "evidence_root":
            str(evidence_root),

        "summary":
            summary,

        "observations":
            observations,

        "governance": {
            "read_only":
                True,

            "records_are_unique_grants":
                False,

            "portfolio_can_authorize":
                False,

            "portfolio_can_submit":
                False,

            "portfolio_can_execute":
                False,

            "portfolio_can_mutate_source":
                False,

            "portfolio_priority_is_authorization":
                False,
        },

        "authority": {
            "changed": False,
        },
    }

    json_path = (
        output / "funding-portfolio.json"
    )

    html_path = (
        output / "index.html"
    )

    json_path.write_text(
        json.dumps(
            portfolio,
            indent=2,
        )
        + "\n"
    )

    html_path.write_text(
        build_html(
            observations,
            summary,
        )
    )

    print(
        "PORTFOLIO_OBSERVATIONS="
        + str(
            summary["observation_records"]
        )
    )

    print(
        "VALIDATION_ERRORS="
        + str(
            summary["validation_errors"]
        )
    )

    print(
        "VALIDATION_WARNINGS="
        + str(
            summary["validation_warnings"]
        )
    )

    print(
        "QUEUE_ITEMS="
        + str(
            summary["queue_items"]
        )
    )

    print(f"PORTFOLIO_JSON={json_path}")
    print(f"PORTFOLIO_HTML={html_path}")

    print("PORTFOLIO_CREATED=TRUE")
    print("PORTFOLIO_READ_ONLY=TRUE")

    print(
        "RECORDS_ARE_UNIQUE_GRANTS=FALSE"
    )

    print(
        "PORTFOLIO_CAN_AUTHORIZE=FALSE"
    )

    print(
        "PORTFOLIO_CAN_SUBMIT=FALSE"
    )

    print(
        "PORTFOLIO_CAN_EXECUTE=FALSE"
    )

    print(
        "PORTFOLIO_CAN_MUTATE_SOURCE=FALSE"
    )

    print(
        "PORTFOLIO_PRIORITY_IS_AUTHORIZATION=FALSE"
    )

    print("AUTHORITY_CHANGED=FALSE")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
