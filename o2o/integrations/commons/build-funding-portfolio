#!/usr/bin/env python3

from __future__ import annotations

import argparse
import html
import json
from collections import Counter
from datetime import datetime, timezone
from pathlib import Path
import sys


def fail(message: str, code: int = 1) -> None:
    print(f"ERROR={message}", file=sys.stderr)
    raise SystemExit(code)


def load_json(path: Path) -> dict:
    if not path.exists():
        fail(f"required artifact missing: {path}")

    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        fail(f"invalid JSON in {path}: {exc}")


def load_ledger(path: Path) -> list[dict]:
    if not path.exists():
        fail(f"ledger not found: {path}")

    records = []

    for number, line in enumerate(
        path.read_text().splitlines(),
        start=1,
    ):
        if not line.strip():
            continue

        try:
            records.append(json.loads(line))
        except json.JSONDecodeError as exc:
            fail(
                f"invalid ledger JSON line {number}: {exc}"
            )

    if not records:
        fail("ledger contains no evidence records")

    return records


def assert_ledger_boundary(record: dict) -> None:
    required_false = {
        "authorization_occurred":
            record.get("authorization_occurred"),
        "execution_occurred":
            record.get("execution_occurred"),
        "authority_changed":
            record.get("authority_changed"),
    }

    violations = [
        key
        for key, value in required_false.items()
        if value is not False
    ]

    if violations:
        fail(
            "ledger truth boundary violation: "
            + ",".join(violations)
        )


def assert_bundle_boundary(
    manifest: dict,
    queue: dict,
    view: dict,
) -> None:

    mg = manifest.get("governance", {})
    qg = queue.get("governance", {})
    vg = view.get("governance", {})

    required_false = {
        "manifest.evidence_is_authorization":
            mg.get("evidence_is_authorization"),

        "manifest.queue_is_authorization":
            mg.get("queue_is_authorization"),

        "manifest.queue_is_execution":
            mg.get("queue_is_execution"),

        "manifest.mender_can_authorize":
            mg.get("mender_can_authorize"),

        "manifest.mender_can_submit":
            mg.get("mender_can_submit"),

        "manifest.mender_is_governor":
            mg.get("mender_is_governor"),

        "manifest.authority.changed":
            manifest.get(
                "authority", {}
            ).get("changed"),

        "queue.queue_is_authorization":
            qg.get("queue_is_authorization"),

        "queue.queue_is_execution":
            qg.get("queue_is_execution"),

        "queue.mender_can_authorize":
            qg.get("mender_can_authorize"),

        "queue.mender_can_submit":
            qg.get("mender_can_submit"),

        "queue.authority.changed":
            queue.get(
                "authority", {}
            ).get("changed"),

        "view.mender_can_authorize":
            vg.get("mender_can_authorize"),

        "view.mender_can_submit":
            vg.get("mender_can_submit"),

        "view.mender_is_governor":
            vg.get("mender_is_governor"),

        "view.authority.changed":
            view.get(
                "authority", {}
            ).get("changed"),
    }

    violations = [
        key
        for key, value in required_false.items()
        if value is not False
    ]

    if violations:
        fail(
            "bundle truth boundary violation: "
            + ",".join(violations)
        )


def esc(value) -> str:
    return html.escape(
        str(value if value is not None else "")
    )


def parse_deadline(value: str):
    if not value:
        return None

    candidates = [
        "%Y-%m-%d",
        "%Y-%m-%dT%H:%M:%S",
        "%Y-%m-%dT%H:%M:%SZ",
    ]

    for fmt in candidates:
        try:
            return datetime.strptime(
                value,
                fmt,
            ).replace(
                tzinfo=timezone.utc
            )
        except ValueError:
            pass

    return None


def deadline_state(value: str) -> str:
    deadline = parse_deadline(value)

    if deadline is None:
        return "UNSPECIFIED"

    now = datetime.now(timezone.utc)

    if deadline < now:
        return "PAST"

    days = (deadline - now).days

    if days <= 7:
        return "WITHIN_7_DAYS"

    if days <= 30:
        return "WITHIN_30_DAYS"

    return "FUTURE"


def load_observation(record: dict) -> dict:
    assert_ledger_boundary(record)

    bundle = Path(
        record["bundle_path"]
    ).expanduser().resolve()

    manifest = load_json(
        bundle / "manifest.json"
    )

    queue = load_json(
        bundle / "queue.json"
    )

    view = load_json(
        bundle / "mender-view.json"
    )

    assert_bundle_boundary(
        manifest,
        queue,
        view,
    )

    proposal = view.get("proposal", {})
    validation = view.get("validation", {})

    queue_items = queue.get(
        "items", []
    )

    return {
        "bundle_id":
            record.get("bundle_id"),

        "created_at":
            record.get("created_at"),

        "source_state":
            view.get("source_state"),

        "classification":
            view.get("classification"),

        "proposal": {
            "title":
                proposal.get("title", ""),

            "funder":
                proposal.get("funder", ""),

            "program":
                proposal.get("program", ""),

            "deadline":
                proposal.get("deadline", ""),

            "deadline_state":
                deadline_state(
                    proposal.get("deadline", "")
                ),

            "completion_percent":
                proposal.get(
                    "completion_percent", 0
                ),
        },

        "validation": {
            "grantkit_checked":
                validation.get(
                    "grantkit_checked", False
                ),

            "errors":
                validation.get("errors", 0),

            "warnings":
                validation.get("warnings", 0),
        },

        "queue": queue_items,

        "queue_items": len(queue_items),

        "truth": {
            "record_is_unique_grant":
                False,

            "portfolio_priority_is_authorization":
                False,

            "authorization_occurred":
                False,

            "execution_occurred":
                False,

            "authority_changed":
                False,
        },
    }


def build_summary(
    observations: list[dict],
) -> dict:

    classifications = Counter(
        item.get(
            "classification",
            "UNKNOWN",
        )
        for item in observations
    )

    deadline_states = Counter(
        item["proposal"].get(
            "deadline_state",
            "UNSPECIFIED",
        )
        for item in observations
    )

    total_errors = sum(
        int(
            item["validation"].get(
                "errors", 0
            )
        )
        for item in observations
    )

    total_warnings = sum(
        int(
            item["validation"].get(
                "warnings", 0
            )
        )
        for item in observations
    )

    total_queue_items = sum(
        int(item.get("queue_items", 0))
        for item in observations
    )

    completion_values = [
        float(
            item["proposal"].get(
                "completion_percent", 0
            )
        )
        for item in observations
    ]

    average_completion = (
        sum(completion_values)
        / len(completion_values)
        if completion_values
        else 0
    )

    return {
        "observation_records":
            len(observations),

        "unique_grants_claimed":
            False,

        "classifications":
            dict(classifications),

        "deadline_states":
            dict(deadline_states),

        "validation_errors":
            total_errors,

        "validation_warnings":
            total_warnings,

        "queue_items":
            total_queue_items,

        "average_completion_percent":
            round(
                average_completion,
                2,
            ),
    }


def build_html(
