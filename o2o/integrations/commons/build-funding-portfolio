    cards = []

    for item in reversed(observations):
        p = item["proposal"]
        v = item["validation"]

        queue_lines = []

        for q in item["queue"]:
            queue_lines.append(
                "<li>"
                f"<strong>{esc(q.get('task'))}</strong>"
                " — "
                f"{esc(q.get('role'))}"
                " — authorization_required=false"
                "</li>"
            )

        queue_html = (
            "<ul>"
            + "".join(queue_lines)
            + "</ul>"
            if queue_lines
            else "<p>No coordination items.</p>"
        )

        cards.append(
            f"""
